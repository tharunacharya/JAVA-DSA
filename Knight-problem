class Solution {
    // Defines the 8 possible movements for a Knight
    static int[] dx = {2, 1, -1, -2, -2, -1, 1, 2};
    static int[] dy = {1, 2, 2, 1, -1, -2, -2, -1};

    public ArrayList<ArrayList<Integer>> knightTour(int n) {
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        int[][] board = new int[n][n];

        // 1. Initialize board with -1 (indicating unvisited)
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                board[i][j] = -1;
            }
        }

        // 2. Start from top-left corner
        board[0][0] = 0;

        // 3. Initiate Backtracking
        // We pass '1' as the next step count because 0 is already taken
        if (solve(0, 0, 1, n, board)) {
            // Convert the primitive 2D array into the required ArrayList structure
            for (int i = 0; i < n; i++) {
                ArrayList<Integer> row = new ArrayList<>();
                for (int j = 0; j < n; j++) {
                    row.add(board[i][j]);
                }
                result.add(row);
            }
        }
        
        // Will be empty if no solution exists (e.g., n=2, n=3, n=4)
        return result; 
    }

    private boolean solve(int x, int y, int step, int n, int[][] board) {
        // Base case: If step reaches n * n, all cells are successfully visited
        if (step == n * n) {
            return true;
        }

        // Try all 8 possible moves
        for (int i = 0; i < 8; i++) {
            int nextX = x + dx[i];
            int nextY = y + dy[i];

            // If the move is valid, make it
            if (isValid(nextX, nextY, n, board)) {
                board[nextX][nextY] = step; // Mark visited
                
                // Recurse to try and finish the tour from this new position
                if (solve(nextX, nextY, step + 1, n, board)) {
                    return true; // Path successful
                }
                
                // BACKTRACK: Path failed, unmark the cell and try the next loop iteration
                board[nextX][nextY] = -1;
            }
        }

        return false; // No valid moves found from this cell
    }

    // Helper method to check board boundaries and if the cell is unvisited
    private boolean isValid(int x, int y, int n, int[][] board) {
        return (x >= 0 && x < n && y >= 0 && y < n && board[x][y] == -1);
    }
}
