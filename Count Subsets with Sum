class Solution {
    static int perfectSum(int[] arr, int target) {
        
        int n=arr.length;
        int prev[]=new int[target+1];
        
        for(int t=0;t<target+1;t++){
            if(t==0 && arr[0]==0){
                prev[t]=2;
            }else if(t==0){
                prev[t]=1;
            }
            else if(t==arr[0]){
                prev[t]=1;
            }
            else{
                prev[t]=0;
            }
        }
        
        for(int i=1;i<n;i++){
            int cur[]=new int[target+1];
            for(int j=0;j<target+1;j++){
                int pick=0;
                if(arr[i]<=j){
                    pick=prev[j-arr[i]];
                }
                int noPick=prev[j];
                cur[j]=pick+noPick;
            }
            prev=cur;
        }
        return prev[target];
    }
        
        
        
        
        
